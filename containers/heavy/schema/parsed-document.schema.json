{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "parser": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "pageCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "no": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "imageKey": {
            "type": "string"
          }
        },
        "required": [
          "no",
          "width",
          "height"
        ],
        "additionalProperties": false
      }
    },
    "toc": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "title",
          "level",
          "page"
        ],
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "bbox": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          },
          "type": {
            "type": "string",
            "enum": [
              "heading",
              "text",
              "figure",
              "table",
              "formula",
              "caption",
              "list"
            ]
          },
          "text": {
            "type": "string"
          },
          "latex": {
            "type": "string"
          },
          "html": {
            "type": "string"
          },
          "imageKey": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "page",
          "bbox",
          "type",
          "confidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "parser",
    "pageCount",
    "pages",
    "blocks"
  ],
  "additionalProperties": false
}
