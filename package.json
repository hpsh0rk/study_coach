{
  "name": "study-coach",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @kj/app dev",
    "build": "pnpm --filter @kj/web build",
    "db:migrate:local": "pnpm --filter @kj/app db:migrate:local",
    "admin:create": "node scripts/create-admin.mjs",
    "fixtures:pdf": "node scripts/make-fixture-pdf.mjs",
    "lint": "eslint . && node scripts/check-ai-boundary.mjs && pnpm lint:deps",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p scripts",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --project=screenshots",
    "deploy": "bash scripts/deploy.sh",
    "eval:run": "tsx scripts/eval/run.ts",
    "eval:render": "tsx scripts/eval/render.ts",
    "lint:deps": "depcruise apps packages scripts/eval --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@kj/ai": "workspace:*",
    "@kj/pdf-structure": "workspace:*",
    "@kj/planner": "workspace:*",
    "@kj/schema": "workspace:*",
    "@kj/templates": "workspace:*",
    "@kj/writer": "workspace:*",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "pdf-lib": "1.17.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
