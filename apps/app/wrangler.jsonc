{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "study-coach",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // React SPA + player. Only the API runs in the Worker first.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "study-coach",
      // Replaced by scripts/deploy.sh with the real id; local dev ignores it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Production values. `pnpm dev` (scripts/local.mjs) switches to development and turns the stub model on;
    // `pnpm start:local` keeps these. AI_CONFIG_KEY is a secret: generated locally, `wrangler secret put` on Cloudflare.
    "ENVIRONMENT": "production",
    // Deterministic stub model when no provider is configured in /admin.
    "AI_ALLOW_STUB": "false",
    // "外部解析服务" (admin switch, off by default): MinerU's token-free agent API unless an admin picks the
    // precise API (token in /admin or the MINERU_API_TOKEN secret). Tests and E2E use "stub".
    "PARSER_MINERU_MODE": "agent"
  }
}
