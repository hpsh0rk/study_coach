{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "study-coach",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // React SPA + player. Only the API runs in the Worker first.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "study-coach",
      // Replaced by scripts/deploy.sh with the real id; local dev ignores it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "development",
    // Deterministic stub model when no provider is configured in /admin. Set "false" in production.
    "AI_ALLOW_STUB": "true"
  }
}
